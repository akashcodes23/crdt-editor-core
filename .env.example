# ==============================================================================
# Converge Environment Configuration Template
# Copy this file to .env or .env.local for local development
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Network Configuration
PORT=1234
HOST=0.0.0.0

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql://crdt:password@localhost:5432/crdthistory
# Discrete PG parameters (used if DATABASE_URL is not set):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=crdt
# PGPASSWORD=password
# PGDATABASE=crdthistory

# Local Cache Storage (LevelDB working cache)
LEVELDB_DIR=./data/leveldb

# Security & Authentication (Mandatory in production or when AUTH_REQUIRED=true)
AUTH_REQUIRED=false
CONVERGE_AUTH_SECRET=development-hmac-auth-secret-min-16-chars-long
ADMIN_API_KEY=development-admin-api-key-min-16-chars-long
ALLOWED_ORIGINS=http://localhost:3000

# Reverse Proxy Trusted Header Mode (Optional enterprise edge integration)
TRUST_PROXY_AUTH=false
PROXY_SHARED_SECRET=

# Resource Bounds & Denial-of-Service Protections
MAX_ROOMS=1000
MAX_TOTAL_CONNECTIONS=5000
MAX_CLIENTS_PER_ROOM=100
MAX_MESSAGES_PER_SEC=200
MAX_PAYLOAD_BYTES=10485760

# Frontend Next.js Client Configuration
NEXT_PUBLIC_WS_URL=ws://localhost:1234
NEXT_PUBLIC_ROOM_NAME=demo
NEXT_PUBLIC_CONVERGE_TOKEN=

